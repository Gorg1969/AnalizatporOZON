# Токен MAX бота (получить на business.max.ru)
MAX_BOT_TOKEN=ваш_токен_сюда

# Платформа
BOT_PLATFORM=max

# URL веб-приложения (после деплоя)
WEBAPP_URL=https://ваш-бот.bothost.tech

# Секретный ключ
SECRET_KEY=сгенерируйте_случайную_строку

# Порт
PORT=8000

# Лимиты
RATE_LIMIT_PER_MINUTE=10
REQUEST_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=10
